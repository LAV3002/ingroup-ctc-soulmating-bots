# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Назначение администраторов по столам: user_id:тег1,тег2; через ';' между админами.
# Администратор управляет только назначенными ему столами. Узнать свой user_id: @userinfobot
ADMIN_TABLES=11111111:converse;22222222:art;33333333:converse,art

# Теги столов через запятую
TABLE_TAGS=converse,art

# Файл pickle-персистентности
PERSISTENCE_FILE=regabot_data.pickle

# Максимум симпатий от одного участника
MAX_SYMPATHIES=3

# Файл с идеями для первой встречи (по тегу стола)
MEETING_IDEAS_FILE=meeting_ideas.txt

# Логирование (уровень, файл, ротация)
LOG_LEVEL=INFO
LOG_FILE=logs/regabot.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# DatingBot (отдельный бот: анкета + тест + подбор метчей). Запуск: python dating_bot.py
# ---------------------------------------------------------------------------

# Отдельный токен для DatingBot от @BotFather (если пусто — читается TELEGRAM_BOT_TOKEN)
DATING_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# user_id администраторов DatingBot через запятую. Узнать свой user_id: @userinfobot
DATING_ADMIN_IDS=11111111,22222222

# Файл pickle-персистентности DatingBot
DATING_PERSISTENCE_FILE=datingbot_data.pickle

# Ограничения возраста анкеты
DATING_MIN_AGE=18
DATING_MAX_AGE=99

# Бонус за близость возраста при подборе метчей
DATING_AGE_BONUS=0.5
DATING_AGE_PENALTY=0.1

# Логирование DatingBot
DATING_LOG_LEVEL=INFO
DATING_LOG_FILE=logs/datingbot.log
